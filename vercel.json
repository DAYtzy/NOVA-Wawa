{
  "version": 2,
  "builds": [
    {"src":"intro.mp4","use":"@vercel/static"},
    {"src":"login.mp4","use":"@vercel/static"},
    {"src":"logo.png","use":"@vercel/static"},
    {"src":"app.py","use":"@vercel/python","config":{"includeFiles":["*.html","*.css","*.js","logo.png","login.mp4","intro.mp4","manifest.json","icon-*.png"]}}
  ],
  "routes": [
    {"handle":"filesystem"},
    {"src":"/(.*)","dest":"app.py"}
  ],
  "regions": ["sin1"]
}
